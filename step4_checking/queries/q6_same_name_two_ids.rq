# CQ5 / rule 16 (exact names only; step 5 normalises accents and spaces)
PREFIX ppo: <https://ul.edu.lb/kr/ont/ppo#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?name (COUNT(DISTINCT ?o) AS ?ids) (GROUP_CONCAT(DISTINCT ?id; separator=" | ") AS ?identifiers)
WHERE { ?o a ppo:Organization ; rdfs:label ?name ; ppo:identifier ?id . }
GROUP BY ?name HAVING (COUNT(DISTINCT ?o) > 1) ORDER BY DESC(?ids) LIMIT 20
